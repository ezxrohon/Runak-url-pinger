# 🫧🦋 ʀuɴAk — URL Pinger
# Copy this file to `.env` for local testing, or add these as
# Environment Variables in your Render service dashboard.

# How often to ping all configured URLs, in milliseconds.
# 60000 = every 1 minute (default if omitted)
PING_INTERVAL_MS=60000

# Port the server listens on.
# Render sets this automatically, so you usually don't need it there —
# it's here for running locally.
PORT=3000

# URLs to ping — use numbered keys starting at 1, in any order.
# Add as many as you need (4, 5, 6, ...).
1=https://example1.com
2=https://example2.com
3=https://example3.com
